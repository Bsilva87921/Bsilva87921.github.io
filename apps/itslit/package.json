{
  "name": "itslit-app",
  "private": true,
  "version": "1.0.0",
  "description": "ItsLit Reading Club for iOS and Android (Capacitor), built from the live site's files.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#4D6C91' --iconBackgroundColorDark '#4D6C91' --splashBackgroundColor '#F4EEE3' --splashBackgroundColorDark '#121011'",
    "sync": "npm run build:web && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
